  "2014": [
    {
      "id": "poem_1",
      "type": "poem",
      "section": "Panorama",
      "chapter": "14",
      "chapter_name": "Koel",
      "question": "Read the stanza given below and answer the questions that follow:",
      "prashna": "नीचे दिए गए पद्यांश को पढ़ें और उसके बाद आने वाले प्रश्नों के उत्तर दें:",
      "context": "The fire of love has charred my wings and make me a new. \nI am restless. Where is my beloved?\nThe sight of mango blossoms fires me at the more!\nThe greener the garden, the brighter burns my heart!\nMy flaming soul asks \"Where I where is my beloved?\"\nSpeak! Speak! Where are they leaves so still?\"",
      "sub_questions": {
        "1": "What charred the wings of the koel?",
        "2": "Why is koal restless?",
        "3": "What burns her heart?",
        "4": "What does the flaming soul of the koel ask?"
      },
      "anuprashna": {
        "1": "कोयल के पंखों को किसने झुलसा दिया?",
        "2": "कोयल क्यों बेचैन है?",
        "3": "उसका हृदय क्या जलाता है?",
        "4": "कोयल की जलती हुई आत्मा क्या पूछती है?"
      }
    }
  ],
